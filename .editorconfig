[*]
charset = utf-8
end_of_line = lf
insert_final_newline=true
max_line_length = 160
trim_trailing_whitespace = true

[*Makefile]
indent_style = tab

[*Dockerfile]
indent_style = tab

[*.{php,phpt}]
indent_style = space
indent_size = 4

[*.{yml,yaml,neon}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4
